# Server Environment Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection
MONGO_URI=mongodb://localhost:27017/arena_aiml

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars

# AI Hub Provider Configuration
# Options for AI_PROVIDER: gemini | openai | mock
AI_PROVIDER=gemini

# Google Gemini API Key (Recommended - Get from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (Optional alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Email Delivery Configuration (Optional - leaves in mock mode if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Arena AIML <events@arena.aiml>